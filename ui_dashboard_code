#3. GEE Data Processing Pipeline 

@st.cache.data(ttl=3600)
def process_mccc_data(lat_vol, lon_val, buf_m, start_s, end_s, cloud_pct):
    roi = ee.Geometry.Point([lon_val, lat_val]).buffer(buf_m).bounds()

    #1. Sentinel-2 Image Collection 
    dataset = (ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
              .filterBounds (roi)
              .filterDate(start_s, end_s)
              .filter(ee.Filter,lt('CLOUDY_PIXEL_PERCENTAGE', cloud_pct))
              .median())


    #2. Advanced Water Analysis: MNDWI = (Green - SWIR1) / (Green + SWIR1)
    mndwi = dataset.normalizedDifference(['B3', 'B11']).rename('MNDWI')

    #3. Water Quality/Level Proxy (Turbinity/Sediment) = Red / Green
    turbinity = dataset.select('B4).divide(dataset.select('B3')).rename('Turbinity')
    turbidity_masked = turbidity.updateMask(mndwi.gt(0))

    #4. Soil Adjusted Vegetation Index (SAVI)
    # ((NIR + RED + L)) * (1 + L)
    savi = dataset.expression(
          ' ((NIR - RED) / ((NIR - RED + L)) * (1 + L)', {
              'NIR' : dataset.select('B8'),
              'RED' : dataset.select('B4'),
              'L': 0.5
      }
 ).rename('SAVI')

 # Clip layers to Area of Interest 
 savi_clipped = savi.clip(roi)
 mndwi_clipped = mndwi.clip(roi)
 turb_clipped = turbidity.masked.clip(roi)
 dataset.clipped = dataset.clip(roi)

 # Calculate summary statistics over ROI
 mean_savi = savi.clipped.reduceRegion(
    reducer = ee.Reducer.mean(),
    geometry = roi,
    scale = 10,
    maxPixels = 1e9
).get ('MNDWI').getInfo()

mean_mndwi = mndwi.clipped.reduceRegion(
    reducer = ee.Reducer.mean(),
    geometry = roi,
    scale = 10,
    maxPixels = 1e9
).get ('Turbinity').getInfo()

return dataset_clipped, savi_clipped, mndwi_clipped, turb_img, mean_savi_val, mean_mndwi_val, mean_turb_val = process_mccc_data(
